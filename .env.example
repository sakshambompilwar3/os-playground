# ==========================================
# OS Playground - Environment Variables Example
# Copy to .env or .env.local for local overrides
# DO NOT commit real secrets or production keys
# ==========================================

# Production canonical site URL (used for absolute OpenGraph and Twitter card URLs)
VITE_SITE_URL=https://your-domain.example.com

# Nitro Server Preset (e.g. vercel, node-server, cloudflare-pages)
# When deploying to Vercel, set:
# NITRO_PRESET=vercel

# Supabase database connection (for future cloud persistence of notes & quizzes)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key

# AI Chatbot API configuration (for server-side functions / API route handlers only)
# NOTE: Never expose AI API keys to client-side bundles (do not prefix with VITE_)
# GEMINI_API_KEY=your-gemini-api-key
